{
  "name": "fu-learning-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "format": "prettier --write \"./**/*.{js,jsx,ts,tsx,css,scss,md,json,html}\" ",
    "lint": "lint-staged",
    "lint:staged": "lint-staged",
    "type-check": "tsc",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "next lint --fix .",
      "npm run format"
    ],
    "*.{scss,html}": [
      "npm run format"
    ]
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@reduxjs/toolkit": "^2.8.0",
    "@tanstack/react-query": "^5.75.4",
    "antd": "^5.24.9",
    "axios": "^1.9.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "framer-motion": "^12.9.7",
    "moment": "^2.30.1",
    "next": "15.3.1",
    "react": "^19.1.0",
    "react-card-flip": "^1.2.3",
    "react-dom": "^19.1.0",
    "react-player": "^2.16.0",
    "react-redux": "^9.2.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/eslintrc": "^3",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/next": "^8.0.7",
    "@types/node": "^24.0.10",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/socket.io-client": "^1.4.36",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.5",
    "typescript": "^5"
  }
}
